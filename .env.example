# Smart Expense Intelligence - environment variables (PRD section 19.4)
# Copy to .env (make setup does this). Placeholders only - never commit real secrets.

APP_ENV=local                      # local | ci | demo
LOG_LEVEL=INFO

# --- backend / worker ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sei
# REDIS_URL=redis://localhost:6379/0   # optional; in-process cache when unset
JWT_SECRET=change-me-to-at-least-32-random-bytes-xxxxxxxx
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000
COOKIE_SECURE=true                 # refresh cookie Secure flag; keep true outside plain-http dev
CORS_ORIGINS=http://localhost:3000
CURSOR_SIGNING_KEY=change-me-cursor-signing-key
EXPORT_PSEUDONYM_KEY=change-me-pseudonym-key
MAX_TRANSACTION_AMOUNT=1000000000
MIN_ALERT_AMOUNT=50000
ANOMALY_ALERTS_PER_PERIOD=3
FORECAST_FORCE_BASELINE=false      # kill switch: force run-rate baseline
DEMO_MODE=false
DEMO_USER_PASSWORD=change-me-demo-password
# DEMO_USER_EMAIL=demo@example.com   # used by `make seed-demo`

# --- ML service client ---
ML_SERVICE_URL=http://ml-service:8080
ML_TIMEOUT_MS=300
ML_AUTH=none                       # none locally, google_id_token in GCP

# --- events ---
EVENT_BUS=inmemory                 # inmemory | pubsub
# PUBSUB_PROJECT_ID=
# PUBSUB_TOPIC=transaction-events
# PUBSUB_EMULATOR_HOST=localhost:8085
# INTERNAL_OIDC_AUDIENCE=
# INTERNAL_ALLOWED_SA=

# --- ml-service ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_SOURCE=mlflow                # mlflow | local_dir
MODEL_POLL_INTERVAL_S=300
SHADOW_ENABLED=false
REQUIRED_MODELS=transaction-classifier

# --- pipelines ---
DATA_BACKEND=local                 # local | bigquery
# GCP_PROJECT_ID=
# GCS_DATASETS_BUCKET=
# GCS_REPORTS_BUCKET=

# --- docker compose (host ports; all bind 127.0.0.1) ---
# POSTGRES_PORT=5432  REDIS_PORT=6379  MLFLOW_PORT=5000  ML_PORT=8080  BACKEND_PORT=8000  FRONTEND_PORT=3000
# CLASSIFIER_ALIAS=production   # `make demo` uses candidate until a version is promoted

# --- frontend ---
BACKEND_INTERNAL_URL=http://backend:8000

# --- observability (optional) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
# ALERT_WEBHOOK_URL=

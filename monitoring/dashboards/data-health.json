{
  "uid": "sei-data-health",
  "title": "Data health",
  "tags": [
    "sei"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CSV imports by stage and outcome",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage, outcome) (increase(csv_imports_total[1d]))",
          "legendFormat": "{{stage}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Import rejection share",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(csv_imports_total{outcome=\"rejected\"}[1d])) / sum(increase(csv_imports_total{stage=\"preview\"}[1d]))",
          "legendFormat": "rejected / previews",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Prediction inputs by decision (volume)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(predictions_total[1d]))",
          "legendFormat": "predictions per day",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "text",
      "title": "Drift and quarantine",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Unseen-merchant share, feature PSI and quarantine counts come from the Evidently drift job (PRD 18.3, task T-35). Until it runs these panels do not exist; the HTML report goes to `gs://<project>-reports/drift/`."
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sei.local/schemas/events/transaction.deleted.v1.json",
  "title": "transaction.deleted (schema_version 1)",
  "description": "PRD 14.3. Payloads carry ids and enums only: never descriptions, merchants, notes or amounts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "user_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "event_type": {
      "const": "transaction.deleted"
    },
    "schema_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "user_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transaction_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "transaction_version": {
          "type": "integer",
          "minimum": 1
        },
        "transaction_type": {
          "enum": [
            "income",
            "expense",
            "transfer"
          ]
        },
        "source": {
          "enum": [
            "manual",
            "csv",
          "demo_seed"
          ]
        },
        "import_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "transaction_id",
        "transaction_version",
        "transaction_type",
        "source",
        "import_id"
      ]
    }
  }
}

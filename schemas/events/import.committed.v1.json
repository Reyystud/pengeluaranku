{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sei.local/schemas/events/import.committed.v1.json",
  "title": "import.committed (schema_version 1)",
  "description": "PRD 14.3. Payloads carry ids and enums only: never descriptions, merchants, notes or amounts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "user_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "event_type": {
      "const": "import.committed"
    },
    "schema_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "user_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "import_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "committed_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "import_id",
        "committed_count"
      ]
    }
  }
}
